# Development Node.js Alpine Container with Live Watching
FROM node:22-alpine

# Set working directory
WORKDIR /app

# Copy package manifests
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy application source code
COPY . .

# Set development environment
ENV NODE_ENV=development
ENV PORT=8081

# Expose server port
EXPOSE 8081

# Run development server with native live file watcher
CMD ["node", "--watch", "server.js"]
